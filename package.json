{
  "name": "vocabmaster",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "checkpoint:validate": "node scripts/validate-checkpoint.mjs",
    "verify": "node scripts/verify.mjs",
    "free:strip": "node scripts/prepare-free-build.mjs",
    "free:restore": "node scripts/prepare-free-build.mjs --restore"
  },
  "dependencies": {
    "@expo/ui": "~58.0.21",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.16",
    "expo-dev-client": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-notifications": "~58.1.5",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-speech": "~58.0.3",
    "expo-speech-recognition": "~58.0.0",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-widgets": "~58.0.21",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
