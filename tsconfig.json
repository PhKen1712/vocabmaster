{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx",
    // Chỉ rõ global của test runner; TS 6 không tự nạp @types/jest cho file test.
    "types": ["jest"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // `admin` (Vite, tsconfig riêng) và `supabase/functions` (Deno) không thuộc
  // tsconfig của app; để nguyên trong include sẽ làm typecheck của app báo lỗi giả.
  "exclude": ["node_modules", "ios", "android", "admin", "supabase"]
}
