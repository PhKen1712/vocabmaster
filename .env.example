# ---------------------------------------------------------------------------
# VocabMaster environment template
# Copy to .env only if you really need build-time values.
# NEVER commit .env (it is ignored by .gitignore).
# ---------------------------------------------------------------------------

# Optional: Google Gemini API key.
# NOT recommended for this project. Any variable starting with EXPO_PUBLIC_
# is embedded in the shipped JavaScript bundle in clear text. VocabMaster
# instead asks for the key inside the app (Settings) and stores it in the
# iOS Keychain via expo-secure-store. Leave this empty.
# EXPO_PUBLIC_GEMINI_API_KEY=

# Optional: model name override (safe to ship, not a secret).
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash

# EAS / Apple credentials are NOT stored in .env for this project.
# EAS CLI stores them in its own credential store and on expo.dev servers.
# Required secrets only if you use GitHub Actions:
#   EXPO_TOKEN          - Expo access token (never commit)
#   APPLE_ID            - your Apple account email (never commit)
#   APPLE_APP_PASSWORD  - app-specific password (never commit)
